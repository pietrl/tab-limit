{
    "manifest_version": 3,
    "name": "Tab Limit",
    "version": "1.0",

    "description": "Limits how many browser tabs you can open to 10.",

    "browser_specific_settings": {
        "gecko": {
            "id": "temporary-id@tab-limit",
            "data_collection_permissions": {
                "required": ["none"]
            }
        }
    },
    "background" : {
        "scripts": ["tab-limit.js"]
    },
    "permissions": ["tabs", "notifications"]
}
